# ==============================================================================
# Baobab - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' for production or '.env.dev' for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# System & Localization
# ------------------------------------------------------------------------------
TZ=Europe/Paris

# ------------------------------------------------------------------------------
# Application Ports (Host Mapping)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=2400
DB_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
OLLAMA_PORT=11434


# ------------------------------------------------------------------------------
# PostgreSQL / pgvector Database
# ------------------------------------------------------------------------------
DB_USER=baobab
DB_PASSWORD=replace_with_secure_database_password
DB_NAME=baobab_db
DATABASE_URL=postgres://baobab:replace_with_secure_database_password@baobab-db:5432/baobab_db

# ------------------------------------------------------------------------------
# MinIO Object Storage (S3-compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=baobab_admin
MINIO_ROOT_PASSWORD=replace_with_secure_minio_password
MINIO_BUCKET=baobab-bucket
# Internal endpoint used by backend inside docker network
MINIO_ENDPOINT=http://baobab-storage:9000
# External endpoint accessed by browser/clients (e.g., https://s3.yourdomain.com or http://localhost:9000)
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000

# ------------------------------------------------------------------------------
# Ollama / Local AI Models
# ------------------------------------------------------------------------------
# Internal endpoint or remote Ollama server (e.g., http://baobab-ollama:11434 or http://192.168.1.100:11434)
OLLAMA_URL=http://baobab-ollama:11434
# LLM model to pull and use for Q&A and RAG
OLLAMA_LLM_MODEL=mistral:7b
# Embedding model for vector embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# Backend & Security
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=2400
HOST=0.0.0.0
# Generate a strong 64+ char random string: openssl rand -base64 48
JWT_SECRET=replace_with_a_very_long_and_cryptographically_secure_jwt_secret_key
# Allowed frontend origins for CORS (comma-separated or single domain)
FRONTEND_URL=http://localhost
